      <column caption='Fraud Rate' datatype='real' name='[Calculation_598626954648162304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Fraudulent])/COUNT([Transaction_ID])' />
      </column>
      <column caption='Avg Transaction Amt' datatype='real' name='[Calculation_598626954650304513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Transaction_Amount])/COUNT([Transaction_ID])' />
